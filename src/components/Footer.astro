---
import { site } from '../site.config';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap wrap--wide inner">
    <p class="sig">
      <span class="dot" aria-hidden="true"></span>
      © {year} {site.author}. Built with Astro, deployed on GitHub Pages.
    </p>
    <ul class="socials">
      {
        site.socials.map((s) => (
          <li>
            <a href={s.href} class="link-underline" rel="me noopener" target={s.href.startsWith('http') ? '_blank' : undefined}>
              {s.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    background: color-mix(in oklab, var(--bg) 60%, transparent);
    padding-block: 2rem;
    font-size: 0.85rem;
    color: var(--text-dim);
  }
  .inner {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.5rem;
    align-items: center;
    justify-content: space-between;
  }
  .sig {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }
  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 10px var(--accent);
  }
  .socials {
    display: flex;
    gap: 1.1rem;
    list-style: none;
    margin: 0;
    padding: 0;
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }
</style>
