---
/**
 * Click-to-zoom image viewer for post content.
 * Progressive enhancement: every `.prose img` becomes a button that opens a
 * modal <dialog> with the image at full size, arrow-key / button navigation
 * between all images in the post, and click-to-toggle 1:1 zoom.
 */
---

<dialog id="lightbox" class="lb" aria-label="Image viewer">
  <button type="button" class="lb-btn lb-close" data-lb="close" aria-label="Close viewer">
    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"
      ><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"
    /></svg>
  </button>

  <button type="button" class="lb-btn lb-nav lb-prev" data-lb="prev" aria-label="Previous image">
    <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"
      ><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
    /></svg>
  </button>

  <figure class="lb-figure">
    <img class="lb-img" alt="" />
    <figcaption class="lb-cap" hidden></figcaption>
  </figure>

  <button type="button" class="lb-btn lb-nav lb-next" data-lb="next" aria-label="Next image">
    <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"
      ><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
    /></svg>
  </button>

  <p class="lb-counter" aria-hidden="true"></p>
</dialog>

<style is:global>
  .prose img.zoomable {
    cursor: zoom-in;
  }
  .prose img.zoomable:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }

  .lb {
    /* fill the viewport; the element itself is the click-to-close backdrop */
    width: 100vw;
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    margin: 0;
    padding: clamp(1rem, 4vw, 3rem);
    border: 0;
    background: transparent;
    color: var(--text);
    overflow: auto;
    place-items: center;
    place-content: center;
  }
  .lb[open] {
    display: grid;
  }
  .lb::backdrop {
    background: rgba(4, 5, 9, 0.97);
  }
  @supports (backdrop-filter: blur(1px)) {
    .lb::backdrop {
      background: rgba(4, 5, 9, 0.88);
      backdrop-filter: blur(10px);
    }
  }

  .lb-figure {
    margin: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none; /* clicks fall through to the dialog, except on the img */
  }
  .lb-img {
    display: block;
    max-width: min(94vw, 1500px);
    max-height: 80dvh;
    width: auto;
    height: auto;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.04),
      0 30px 80px -20px rgba(0, 0, 0, 0.8),
      0 0 90px -20px color-mix(in oklab, var(--accent) 40%, transparent);
    cursor: zoom-in;
    pointer-events: auto;
  }
  .lb-img.is-zoomed {
    max-width: none;
    max-height: none;
    cursor: zoom-out;
  }
  .lb-cap {
    position: fixed;
    bottom: 1.1rem;
    left: 50%;
    transform: translateX(-50%);
    max-width: min(88vw, 62ch);
    margin: 0;
    padding: 0.4rem 0.9rem;
    border-radius: 999px;
    background: color-mix(in oklab, var(--surface-solid) 78%, transparent);
    backdrop-filter: blur(8px);
    border: 1px solid var(--border);
    text-align: center;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    line-height: 1.5;
    color: var(--text-dim);
    pointer-events: auto;
  }
  .lb-cap[hidden] {
    display: none;
  }

  .lb-btn {
    position: fixed;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 2.9rem;
    height: 2.9rem;
    border-radius: 999px;
    border: 1px solid var(--border-strong);
    background: color-mix(in oklab, var(--surface-solid) 80%, transparent);
    backdrop-filter: blur(8px);
    color: var(--text-dim);
    cursor: pointer;
    transition:
      color 0.18s var(--ease),
      border-color 0.18s var(--ease),
      box-shadow 0.18s var(--ease),
      transform 0.18s var(--ease);
  }
  .lb-btn:hover {
    color: var(--accent);
    border-color: var(--accent);
    box-shadow: var(--glow);
  }
  .lb-close {
    top: 1rem;
    right: 1rem;
  }
  .lb-nav {
    top: 50%;
    transform: translateY(-50%);
  }
  .lb-nav:hover {
    transform: translateY(-50%) scale(1.08);
  }
  .lb-prev {
    left: 1rem;
  }
  .lb-next {
    right: 1rem;
  }
  .lb-counter {
    position: fixed;
    top: 1.1rem;
    left: 50%;
    transform: translateX(-50%);
    margin: 0;
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    background: color-mix(in oklab, var(--surface-solid) 78%, transparent);
    backdrop-filter: blur(8px);
    border: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.08em;
    color: var(--text-faint);
  }
  .lb-counter:empty {
    display: none;
  }

  @media (max-width: 600px) {
    .lb-btn {
      width: 2.6rem;
      height: 2.6rem;
    }
    .lb-prev {
      left: 0.5rem;
    }
    .lb-next {
      right: 0.5rem;
    }
    .lb-cap {
      bottom: 0.75rem;
    }
  }

  /* Entrance/exit animation (modern browsers; instant fallback otherwise). */
  @media (prefers-reduced-motion: no-preference) {
    .lb,
    .lb::backdrop {
      transition:
        opacity 0.22s var(--ease),
        overlay 0.22s var(--ease) allow-discrete,
        display 0.22s var(--ease) allow-discrete;
      opacity: 0;
    }
    .lb[open],
    .lb[open]::backdrop {
      opacity: 1;
    }
    @starting-style {
      .lb[open],
      .lb[open]::backdrop {
        opacity: 0;
      }
    }
    .lb-img {
      transition: opacity 0.15s var(--ease);
    }
  }
</style>

<script>
  const dlg = document.getElementById('lightbox') as HTMLDialogElement | null;
  const imgs = Array.from(
    document.querySelectorAll<HTMLImageElement>('.prose img')
  ).filter((img) => !img.closest('a'));

  if (dlg && imgs.length && typeof dlg.showModal === 'function') {
    const lbImg = dlg.querySelector<HTMLImageElement>('.lb-img')!;
    const lbCap = dlg.querySelector<HTMLElement>('.lb-cap')!;
    const lbCounter = dlg.querySelector<HTMLElement>('.lb-counter')!;
    const prevBtn = dlg.querySelector<HTMLButtonElement>('.lb-prev')!;
    const nextBtn = dlg.querySelector<HTMLButtonElement>('.lb-next')!;
    const solo = imgs.length < 2;
    let index = 0;
    let opener: HTMLElement | null = null;

    if (solo) {
      prevBtn.hidden = true;
      nextBtn.hidden = true;
    }

    const show = (i: number) => {
      index = (i + imgs.length) % imgs.length;
      const src = imgs[index];
      lbImg.classList.remove('is-zoomed');
      lbImg.src = src.currentSrc || src.src;
      lbImg.alt = src.alt || '';
      lbCap.textContent = src.alt || '';
      lbCap.hidden = !src.alt;
      lbCounter.textContent = solo ? '' : `${index + 1} / ${imgs.length}`;
    };

    const open = (i: number, from: HTMLElement) => {
      opener = from;
      show(i);
      dlg.showModal();
      document.body.style.overflow = 'hidden';
    };

    dlg.addEventListener('close', () => {
      document.body.style.overflow = '';
      lbImg.removeAttribute('src');
      opener?.focus();
    });

    imgs.forEach((img, i) => {
      img.classList.add('zoomable');
      img.setAttribute('role', 'button');
      img.setAttribute('tabindex', '0');
      img.setAttribute(
        'aria-label',
        img.alt ? `View image: ${img.alt}` : 'View image'
      );
      img.addEventListener('click', () => open(i, img));
      img.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          open(i, img);
        }
      });
    });

    dlg.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      const action = t.closest('[data-lb]')?.getAttribute('data-lb');
      if (action === 'close' || t === dlg || t === lbCap || t.classList.contains('lb-figure')) {
        dlg.close();
      } else if (action === 'prev') {
        show(index - 1);
      } else if (action === 'next') {
        show(index + 1);
      }
    });

    lbImg.addEventListener('click', (e) => {
      e.stopPropagation();
      lbImg.classList.toggle('is-zoomed');
    });

    dlg.addEventListener('keydown', (e) => {
      if (solo) return;
      if (e.key === 'ArrowLeft') {
        e.preventDefault();
        show(index - 1);
      } else if (e.key === 'ArrowRight') {
        e.preventDefault();
        show(index + 1);
      }
    });
  }
</script>
