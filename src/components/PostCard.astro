---
import FormattedDate from './FormattedDate.astro';
import { readingTime } from '../lib/reading-time';

interface Props {
  post: {
    id: string;
    data: {
      title: string;
      description: string;
      pubDate: Date;
      tags: string[];
    };
    body?: string;
  };
}
const { post } = Astro.props;
const href = `/blog/${post.id}`;
const mins = readingTime(post.body ?? '');
---

<article class="panel reveal card">
  <a href={href} class="cover-link" aria-label={post.data.title}></a>
  <div class="meta">
    <FormattedDate date={post.data.pubDate} />
    <span class="sep" aria-hidden="true">/</span>
    <span class="rt">{mins} min read</span>
  </div>
  <h3 class="title">{post.data.title}</h3>
  <p class="excerpt">{post.data.description}</p>
  {
    post.data.tags.length > 0 && (
      <ul class="tag-list">
        {post.data.tags.slice(0, 4).map((t) => (
          <li>
            <a class="tag" href={`/tags/${t}`}>
              {t}
            </a>
          </li>
        ))}
      </ul>
    )
  }
  <a class="go" href={href} aria-label={`Read "${post.data.title}"`}>
    Read <span class="arrow" aria-hidden="true">→</span>
  </a>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  /* Full-card click target, but real links (tags) stay clickable above it */
  .cover-link {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    z-index: 1;
  }
  .meta,
  .title,
  .excerpt,
  .tag-list,
  .go {
    position: relative;
    z-index: 2;
  }
  .tag-list {
    pointer-events: none;
  }
  .tag-list a {
    pointer-events: auto;
  }
  .meta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .sep {
    color: var(--text-faint);
  }
  .rt {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: var(--text-faint);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .title {
    font-size: 1.3rem;
    transition: color 0.2s var(--ease);
  }
  .card:hover .title {
    color: var(--accent);
  }
  .excerpt {
    margin: 0;
    color: var(--text-dim);
    font-size: 0.95rem;
  }
  .go {
    align-self: flex-start;
    margin-top: 0.25rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--accent);
    letter-spacing: 0.04em;
  }
  .go:hover {
    color: var(--accent-2);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .card:hover .go {
    color: var(--accent-2);
  }
  .arrow {
    display: inline-block;
    transition: transform 0.25s var(--ease);
  }
  .card:hover .arrow {
    transform: translateX(5px);
  }
</style>
