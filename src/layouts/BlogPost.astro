---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import ViewCount from '../components/ViewCount.astro';
import { readingTime } from '../lib/reading-time';

interface Props {
  post: CollectionEntry<'blog'>;
}
const { post } = Astro.props;
const { title, description, pubDate, updatedDate, tags } = post.data;
const mins = readingTime(post.body ?? '');
---

<BaseLayout title={title} description={description} article>
  <article class="post">
    <header class="post-head reveal">
      <p class="eyebrow">Writing</p>
      <h1>{title}</h1>
      <p class="lede">{description}</p>
      <div class="post-meta">
        <FormattedDate date={pubDate} />
        {updatedDate && <FormattedDate date={updatedDate} prefix="· updated" />}
        <span class="sep" aria-hidden="true">/</span>
        <span>{mins} min read</span>
        <ViewCount path={`/blog/${post.id}`} />
      </div>
      {
        tags.length > 0 && (
          <ul class="tag-list">
            {tags.map((t) => (
              <li>
                <a class="tag" href={`/tags/${t}`}>
                  {t}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </header>

    <div class="prose reveal">
      <slot />
    </div>

    <footer class="post-foot">
      <a href="/blog" class="btn">← All writing</a>
      <a href={`https://github.com/dasunpubudumal/dasunpubudumal.github.io/edit/main/src/content/blog/${post.id}.md`} class="btn" target="_blank" rel="noopener">
        Suggest an edit
      </a>
    </footer>
  </article>
</BaseLayout>

<style>
  .post-head {
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
    margin-bottom: 2.5rem;
  }
  .post-head h1 {
    margin-top: 0.8rem;
  }
  .lede {
    color: var(--text-dim);
    font-size: 1.1rem;
    margin-top: 0.9rem;
  }
  .post-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    margin-top: 1.1rem;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--text-faint);
  }
  .post-meta .sep {
    opacity: 0.5;
  }
  .tag-list {
    margin-top: 1rem;
  }

  .prose :global(h2) {
    margin-top: 2.5rem;
    scroll-margin-top: 5rem;
  }
  .prose :global(h3) {
    margin-top: 1.8rem;
    scroll-margin-top: 5rem;
  }
  .prose :global(h2)::before {
    content: '§ ';
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.7em;
    vertical-align: middle;
  }
  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.3rem;
  }
  .prose :global(li) {
    margin-block: 0.35rem;
  }
  .prose :global(li::marker) {
    color: var(--accent);
  }
  .prose :global(a) {
    text-decoration: underline;
    text-decoration-color: var(--border-strong);
    text-underline-offset: 3px;
  }
  .prose :global(a:hover) {
    text-decoration-color: var(--accent);
  }

  /* Figures: never wider than the text column, centered, with a caption
     (the italic paragraph that immediately follows an image). */
  .prose :global(p:has(> img)) {
    margin-block: 1.75rem;
    text-align: center;
  }
  .prose :global(img) {
    display: block;
    margin-inline: auto;
    width: auto;
    max-width: 100%;
  }
  .prose :global(p:has(> img) + p > em:only-child) {
    display: block;
    margin-top: 0.6rem;
    font-size: 0.85rem;
    color: var(--text-faint);
    text-align: center;
  }

  .post-foot {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 3.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }
</style>
