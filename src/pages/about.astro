---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../site.config';
---

<BaseLayout title="About" description={`About ${site.author}.`}>
  <article class="prose reveal">
    <p class="eyebrow">About</p>
    <h1>{site.author}</h1>
    <p class="lede">{site.intro}</p>

    <p>
    I am a Software Developer. I love Software Development. This blog is my safe space to express my ideas.
    </p>
    <p>
    It might not be your cup-of-tea but that's okay.
    </p>

    <h2>Elsewhere</h2>
    <ul>
      {
        site.socials.map((s) => (
          <li>
            <a href={s.href} target={s.href.startsWith('http') ? '_blank' : undefined} rel="me noopener">
              {s.label}
            </a>
          </li>
        ))
      }
    </ul>

    <h2>Colophon</h2>
    <p>
      Built with <a href="https://astro.build" target="_blank" rel="noopener">Astro</a>,
      written in Markdown, compiled to static HTML, and deployed to GitHub Pages
      by a GitHub Actions workflow on every push to <code>main</code>. The layout of this website was created by Claude Code. However, <b>all the content</b> in the website are my original thoughts.
    </p>
  </article>
</BaseLayout>

<style>
  .lede {
    font-size: 1.15rem;
    color: var(--text-dim);
    margin-top: 0.8rem;
  }
  .prose h2 {
    margin-top: 2.5rem;
  }
  .prose ul {
    padding-left: 1.3rem;
  }
  .prose li {
    margin-block: 0.35rem;
  }
  .prose li::marker {
    color: var(--accent);
  }
  .prose a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
