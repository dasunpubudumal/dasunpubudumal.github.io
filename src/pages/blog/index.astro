---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts } from '../../lib/posts';

const posts = await getPosts();
---

<BaseLayout title="Writing" description="Essays and notes." wide>
  <header class="page-head reveal">
    <p class="eyebrow">Writing</p>
    <h1>The log</h1>
    <p class="sub">
      {posts.length} {posts.length === 1 ? 'entry' : 'entries'} — long-form notes,
      build logs, and half-formed theories.
    </p>
  </header>

  {
    posts.length === 0 ? (
      <p class="panel reveal">Nothing published yet.</p>
    ) : (
      <div class="grid">
        {posts.map((post) => (
          <PostCard post={post} />
        ))}
      </div>
    )
  }
</BaseLayout>

<style>
  .page-head {
    margin-bottom: 2.5rem;
  }
  .page-head h1 {
    margin-top: 0.6rem;
  }
  .sub {
    margin-top: 0.8rem;
    color: var(--text-dim);
  }
  .grid {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 21rem), 1fr));
  }
</style>
