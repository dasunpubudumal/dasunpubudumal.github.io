---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { site } from '../site.config';
import { getPosts } from '../lib/posts';

const posts = (await getPosts()).slice(0, 3);
---

<BaseLayout wide>
  <section class="hero reveal">
    <p class="eyebrow">{site.tagline}</p>
    <h1>
      <span class="gradient-text">{site.title}</span>
    </h1>
    <p class="intro">{site.intro}</p>
    <div class="cta">
      <a href="/blog" class="btn btn--primary">Read the writing</a>
      <a href="/about" class="btn">About me</a>
    </div>
    <ul class="socials">
      {
        site.socials.map((s) => (
          <li>
            <a
              href={s.href}
              class="link-underline"
              rel="me noopener"
              target={s.href.startsWith('http') ? '_blank' : undefined}
            >
              {s.label}
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="latest">
    <div class="latest-head reveal">
      <h2>Latest transmissions</h2>
      <a href="/blog" class="link-underline">All posts →</a>
    </div>
    {
      posts.length === 0 ? (
        <p class="empty panel reveal">
          No posts yet. Drop a Markdown file in <code>src/content/blog/</code> to begin.
        </p>
      ) : (
        <div class="grid">
          {posts.map((post) => (
            <PostCard post={post} />
          ))}
        </div>
      )
    }
  </section>
</BaseLayout>

<style>
  .hero {
    padding: 3rem 0 4rem;
    max-width: 46rem;
  }
  .hero h1 {
    margin-top: 0.6rem;
    font-size: clamp(2.6rem, 1.6rem + 5vw, 4.4rem);
  }
  .intro {
    margin-top: 1.4rem;
    font-size: 1.15rem;
    color: var(--text-dim);
    max-width: 40rem;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 2rem;
  }
  .socials {
    display: flex;
    flex-wrap: wrap;
    gap: 1.4rem;
    list-style: none;
    padding: 0;
    margin-top: 2rem;
    font-family: var(--font-mono);
    font-size: 0.82rem;
  }

  .latest {
    margin-top: 1rem;
  }
  .latest-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  .latest-head a {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    white-space: nowrap;
  }
  .grid {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
  }
  .empty {
    color: var(--text-dim);
  }
</style>
